# route.dae
routing {
    dip(geoip:private) && dport(53) -> direct(must)
    domain(geosite:private) -> direct(must)
    dip(geoip:private) -> direct(must)
    dscp(0x4) -> direct(must)
    ### Reserved IPv4 Address
    dip(
        225.0.0.0/8,
        226.0.0.0/7,
        228.0.0.0/6,
        232.0.0.0/8,
        235.0.0.0/8,
        236.0.0.0/6,
        255.255.255.255
    ) -> direct(must)
    ### DNS
    #dip(222.172.200.68) -> direct(must)
    #dip(223.5.5.5) -> direct(must)
    #dip(1.1.1.1) -> US-V6
    # domain(full:dns.cloudflare.com) -> US-V6
    ### DIRECT MACHINE
    # mac('BC:24:11:XX:XX:XX') -> direct(must)
    mac('00:0C:29:6D:68:63') -> US-V6
    ### 禁用Quic，避免CPU高负载及内存泄露
    #l4proto(udp) && dport(443) -> block
